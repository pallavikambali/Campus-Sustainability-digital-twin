APP_ENV=development
DATABASE_URL=postgresql+pg8000://campus:local_dev_only@localhost:5432/campus_twin
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8002
WASTE_DETECTOR=mock
WASTE_YOLO_MODEL_PATH=backend/models/yolov8n.pt
WASTE_IMAGE_STORAGE_DIR=backend/storage/waste-detections
WASTE_MAX_UPLOAD_BYTES=10485760
WASTE_MEDIUM_OBJECT_THRESHOLD=3
WASTE_HIGH_OBJECT_THRESHOLD=5
WASTE_CANDIDATE_CLASSES=bottle,cup,can,plastic bag,paper,cardboard,carton,wrapper,food waste
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
CRITICAL_ALERT_RECIPIENT=

POSTGRES_DB=campus_twin
POSTGRES_USER=campus
POSTGRES_PASSWORD=local_dev_only
